# ===========================================================================
# Quantora — Example Environment File (placeholders only)
# ===========================================================================
# This is a forward-looking, placeholder-only skeleton. It is NOT a complete
# production configuration and contains no real secrets.
#
# How to use (once the relevant phases exist):
#   1. Copy this file to `.env`.
#   2. Replace placeholder values with local development values.
#   3. Never commit `.env` — only this `.env.example` is tracked.
#
# Each block is annotated with the roadmap phase that will populate it.
# Values marked <placeholder> must be replaced before that phase runs.
# ===========================================================================

# ---------------------------------------------------------------------------
# Django application settings — populated later (Phase 3 / Phase 6)
# ---------------------------------------------------------------------------
# DJANGO_SECRET_KEY: a long random string. Never reuse across environments.
DJANGO_SECRET_KEY=<placeholder-generate-a-long-random-value>
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_DEBUG=true
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Exact origins trusted for CSRF-protected unsafe requests (comma-separated;
# empty for local dev — the Vite dev origins are configured in settings).
DJANGO_CSRF_TRUSTED_ORIGINS=
# Exact frontend origin(s) allowed for credentialed CORS (comma-separated, no
# wildcards; empty for local dev — the Vite proxy makes browser calls same-origin).
DJANGO_CORS_ALLOWED_ORIGINS=
# Cookie SameSite policy: Lax (default), Strict, or None (None requires Secure).
DJANGO_COOKIE_SAMESITE=Lax
# Redirect HTTP to HTTPS (production settings). Keep true; may only be false for
# the local TLS-less production-check topology (docker-compose.production-check.yml).
DJANGO_SECURE_SSL_REDIRECT=true

# ---------------------------------------------------------------------------
# PostgreSQL — durable source of truth — populated later (Phase 5)
# ---------------------------------------------------------------------------
POSTGRES_DB=quantora
POSTGRES_USER=quantora
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Connection timeout in seconds (production settings only). Operational
# configuration, not a secret; minimum accepted value is 2.
POSTGRES_CONNECT_TIMEOUT=3
# libpq client TLS mode (production settings only). REQUIRED with no default, so
# a dropped variable fails loudly instead of silently weakening the connection.
# One of: disable, allow, prefer, require, verify-ca, verify-full.
# `disable` here because the local postgres container does not serve TLS; Azure
# uses `verify-full` with the system CA bundle path below.
POSTGRES_SSLMODE=disable
# Certificate authority bundle PATH. Required only when POSTGRES_SSLMODE is
# verify-ca or verify-full; ignored otherwise. In Azure this is the image's
# system bundle, /etc/ssl/certs/ca-certificates.crt.
POSTGRES_SSLROOTCERT=
# Full URL form used by the application, if preferred:
DATABASE_URL=postgresql://quantora:<placeholder-local-dev-password>@localhost:5432/quantora

# ---------------------------------------------------------------------------
# Redis — cache, locks, quotas, Celery broker — populated later (Phase 5 / 25)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Market-data providers — DISABLED by default, private development only
# populated later (Phase 23 / Phase 28)
# ---------------------------------------------------------------------------
# Providers are OFF unless explicitly enabled. Automated tests and the public
# demo must never call live providers (see ADR 001). Keys are for private,
# licensed development use only and must never be committed.
MARKET_DATA_PROVIDER_ENABLED=false
# Twelve Data (primary development provider) — supply your own key locally.
TWELVE_DATA_API_KEY=<placeholder-disabled-by-default>
# Alpha Vantage (secondary development adapter) — disabled by default.
ALPHA_VANTAGE_API_KEY=<placeholder-disabled-by-default>

# ---------------------------------------------------------------------------
# Azure / Application Insights — populated later (Phase 11 / Phase 45)
# ---------------------------------------------------------------------------
# In Azure these are supplied via Key Vault references, not committed values.
APPLICATIONINSIGHTS_CONNECTION_STRING=<placeholder-populated-in-azure>
AZURE_KEY_VAULT_URI=<placeholder-populated-in-azure>
